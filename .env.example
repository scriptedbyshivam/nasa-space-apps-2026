# Optional: enables live Gemini answers in Ask the Science Copilot.
# Leave blank to run the grounded local knowledge-base mode.
GEMINI_API_KEY=""

# Gemini model used for live answers. Defaults to gemini-3.5-flash.
GEMINI_MODEL="gemini-3.5-flash"

# HTTP port for the Express/Vite server. Defaults to 3000.
PORT="3000"
